 drivers/net/wireless/broadcom/b43/dma.c  | 212 ++++++++++++++++++++++++---
 drivers/net/wireless/broadcom/b43/dma.h  |  24 ++-
 drivers/net/wireless/broadcom/b43/main.c |  97 ++++++++++--
 drivers/net/wireless/broadcom/b43/xmit.c |   8 +-
 5 files changed, 319 insertions(+), 33 deletions(-)

--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -1272,6 +1272,14 @@ struct b43_wl {
 	/* Queue of packets to be transmitted. */
 	struct sk_buff_head tx_queue[B43_QOS_QUEUE_NUM];
 
+	/*
+	 * AC: received frames and sent frames whose TX status is known,
+	 * handed to mac80211 by b43_rx_deliver() once the interrupt thread
+	 * has dropped wl->mutex.
+	 */
+	struct sk_buff_head rx_queue;
+	struct sk_buff_head txstatus_queue;
+
 	/* Flag that implement the queues stopping. */
 	bool tx_queue_stopped[B43_QOS_QUEUE_NUM];
 	/* The mac80211 queue is stopped as tx_queue is full */
@@ -1457,7 +1465,8 @@ static inline bool b43_using_pio_transfe
 static inline bool b43_tx_direct(struct b43_wldev *dev)
 {
 	return !b43_using_pio_transfers(dev) &&
-	       !b43_bus_host_is_sdio(dev->dev);
+	       !b43_bus_host_is_sdio(dev->dev) &&
+	       dev->phy.type != B43_PHYTYPE_AC;
 }
 
 /*
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -40,6 +40,30 @@ static inline int tx_slots_per_frame(str
 	return ring->txhdr_in_skb ? 1 : 2;
 }
 
+/* The most slots one frame takes, what the ring keeps free while it runs */
+static inline int tx_slots_max(struct b43_dmaring *ring)
+{
+	if (ring->tx_frag_list)
+		return tx_slots_per_frame(ring) - 1 + B43_TX_MAX_FRAGS;
+	return tx_slots_per_frame(ring);
+}
+
+/*
+ * The txhdr_cache entry of the frame whose first slot is @slot: one per
+ * frame on the other rings, one per slot where frames take a varying number
+ * of slots.
+ */
+static inline int txhdr_index(struct b43_dmaring *ring, int slot)
+{
+	return ring->tx_frag_list ? slot : slot / tx_slots_per_frame(ring);
+}
+
+static inline int txhdr_entries(struct b43_dmaring *ring)
+{
+	return ring->tx_frag_list ? ring->nr_slots :
+	       ring->nr_slots / tx_slots_per_frame(ring);
+}
+
