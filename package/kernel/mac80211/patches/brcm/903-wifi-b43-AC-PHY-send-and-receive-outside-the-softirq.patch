 			   enum b43_addrtype addrtype)
 {
@@ -393,7 +417,7 @@ static inline
 {
 	B43_WARN_ON(ring->tx);
 	dma_sync_single_for_cpu(ring->dev->dev->dma_dev,
-				    addr, len, DMA_BIDIRECTIONAL);
+				    addr, len, ring->rx_dir);
 }
 
 static inline
@@ -402,7 +426,7 @@ static inline
 {
