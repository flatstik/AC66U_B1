--- a/drivers/net/wireless/broadcom/b43/Kconfig
+++ b/drivers/net/wireless/broadcom/b43/Kconfig
@@ -150,13 +150,33 @@ config B43_PHY_LCN
 	  Say N, this is BROKEN and crashes driver.
 
 config B43_PHY_AC
-	bool "Support for AC-PHY (802.11ac) devices (BROKEN)"
-	depends on B43 && B43_BCMA && BROKEN
+	bool "Support for AC-PHY (802.11ac) devices"
+	depends on B43 && B43_BCMA
 	help
 	  This PHY type can be found in the following chipsets:
 	  PCI: BCM4352, BCM4360
 
-	  Say N, this is BROKEN and crashes driver.
+	  Support is experimental.
+
+	  If unsure, say N.
+
+config B43_DFS
+	bool "Radar channels in AP mode on the AC-PHY"
+	depends on B43_PHY_AC && CFG80211_CERTIFICATION_ONUS
+	help
+	  Let an access point run on channels that require radar detection,
+	  at 20, 40 and 80 MHz. mac80211 runs the channel availability check;
+	  the AC-PHY arms its radar detector as the stock driver does, blanks it
+	  while the AP transmits, and polls its pulse FIFOs every 150 ms. The
+	  pulses are matched against the radar test signals of the regulatory
+	  domain's DFS region: ETSI EN 301 893 (1-6, the staggered 5 and 6
+	  included) or FCC KDB 905462 (types 0-6), both regions' where it is
+	  neither.
+
+	  Tested on the RT-AC66U B1 only, with pulses from an SDR; this is
+	  not a certified radar detector.
+
+	  Say N.
 
 # This config option automatically enables b43 LEDS support,
 # if it's possible.
