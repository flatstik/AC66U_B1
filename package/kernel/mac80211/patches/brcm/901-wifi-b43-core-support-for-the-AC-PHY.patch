+	u32 rx_amsdu_err;
+	/* Word address of the microcode's beamforming block, 0 without. */
+	u16 txbf_base;
+	struct b43_txbf_link txbf[B43_TXBF_SLOTS];
 	bool radio_hw_enable;	/* saved state of radio hardware enabled state */
 	bool qos_enabled;		/* TRUE, if QoS is used. */
 	struct b43_ampdu_tx_ctx ampdu_tx;
@@ -929,6 +1126,8 @@ struct b43_wldev {
 	/* Use b43_using_pio_transfers() to check whether we are using
 	 * DMA or PIO data transfers. */
 	bool __using_pio_transfers;
+	/* DMA64 TX ring 0 address mask read back, 0 until b43_dma_init() */
+	u32 dma64_ringmask;
 
 	/* Various statistics about the physical device. */
 	struct b43_stats stats;
@@ -947,6 +1146,23 @@ struct b43_wldev {
 	/* Periodic tasks */
 	struct delayed_work periodic_work;
 	unsigned int periodic_state;
+	struct delayed_work radar_work;
